using Gtk 4.0;
using Adw 1;

template $MathCell : $Cell {
  Gtk.Box {
    orientation: horizontal;
    Gtk.Image {
      icon-name: "list-drag-handle-symbolic";
      opacity: 0.5;
    }

  Gtk.Box {
    orientation: vertical;
    valign: center;
    halign: center;
    hexpand: true;

    Gtk.Box {
      orientation: horizontal;
      valign: center;
      halign: center;
      hexpand: true;
      Viewport editor_viewport {
        //Equation editor goes here
      }
      Label result_text {
        label: "";
        use-markup: true;
      }
    }
    Gtk.Revealer long_text_revealer {
      Gtk.Label long_text {
        label: "";
        opacity: 0.5;
        wrap: true;
        wrap-mode: word;
      }
    }
  }
  }
}