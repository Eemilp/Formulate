using Gtk 4.0;
using Adw 1;

template $Cell : Gtk.ListBoxRow {
  margin-start: 10;
  margin-end: 10;
  Gtk.Box { //TODO this should probably be inside DragIcon
    orientation: horizontal;
    Gtk.Image {
      icon-name: "list-drag-handle-symbolic";
      opacity: 0.5;
    }
    Adw.Clamp {
      Adw.Bin cell_content {
      //holds the cell content
      }
    }
  }
}

